DJANGO_SECRET_KEY=replace-with-a-strong-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=panwarfm@gmail.com
EMAIL_HOST_PASSWORD=replace-with-email-password-or-app-password
DEFAULT_FROM_EMAIL=your-email@example.com
CONTACT_NOTIFICATION_EMAIL=your-email@example.com

WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_TO_NUMBER=replace-with-destination-number
